{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "./out-tsc/app",
    "types": [],
    "allowSyntheticDefaultImports": true
  },
  "files": ["src/main.single-spa.ts"],
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/test/**/*.ts",
    "src/test-setup.ts",
    "src/api/notification/api.base.service.ts",
    "src/api/notification/encoder.ts",
    "src/api/notification/query.params.ts",
    "src/app/shared/helpers.service.ts"
  ]
}
